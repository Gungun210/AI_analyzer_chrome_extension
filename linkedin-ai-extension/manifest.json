{
  "manifest_version": 3,
  "name": "LinkedIn AI Optimizer",
  "version": "1.0",
  "description": "Improve LinkedIn profile with AI",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.agent.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"]
    }
  ]
}